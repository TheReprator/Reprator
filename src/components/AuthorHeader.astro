---
import { site } from '../data/site';

interface Props {
  compact?: boolean;
  showBio?: boolean;
}

const { compact = false, showBio = true } = Astro.props;
---

<header class:list={['author-header', { 'author-header--compact': compact }]}>
  <a
    class="author-link"
    href="/"
    aria-label={`All posts from ${site.name}`}
  >
    <img
      class="avatar"
      src="/avatar.jpg"
      alt=""
      width="50"
      height="50"
      decoding="async"
    />
    <span class="author-name">{site.name}</span>
  </a>

  {showBio && <p class="bio" set:html={site.bioHtml} />}
</header>
