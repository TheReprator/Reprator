---
import type { PostBlock } from '../data/posts';

interface Props {
  blocks: PostBlock[];
}

const { blocks } = Astro.props;
---

<div class="article__body">
  {blocks.map((block) => {
    if (block.type === 'paragraph') {
      return <p set:html={block.content} />;
    }

    if (block.type === 'heading') {
      return <h2>{block.content}</h2>;
    }

    if (block.type === 'quote') {
      return (
        <blockquote>
          <p set:html={block.content} />
          {block.cite && <cite set:html={block.cite} />}
        </blockquote>
      );
    }

    if (block.type === 'list') {
      return (
        <ul>
          {block.items.map((item) => (
            <li set:html={item} />
          ))}
        </ul>
      );
    }

    return null;
  })}
</div>
